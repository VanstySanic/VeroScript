# Aggregate discovery for existing SDK consumers; module contracts are owned separately.

@PACKAGE_INIT@

set(_vs_available "@VEROSCRIPT_VISUAL_COMPONENTS@")
set(VeroScriptVisual_SDL3_AUDIO @VEROSCRIPT_SDL3_AUDIO@)
set(VeroScriptVisual_SDL3_CONTROLLERS @VEROSCRIPT_SDL3_CONTROLLERS@)
if(TARGET VeroScript AND NOT TARGET VeroScript::Core)
	add_library(VeroScript::Core ALIAS VeroScript)
elseif(TARGET VeroScript::VeroScript AND NOT TARGET VeroScript::Core)
	add_library(VeroScript::Core ALIAS VeroScript::VeroScript)
endif()

set(_vs_wanted ${VeroScriptVisual_FIND_COMPONENTS})
if(NOT _vs_wanted)
	# Default to the available native components. Script adapters additionally
	# require an explicitly supplied matching Core target.
	set(_vs_wanted ${_vs_available})
	if(NOT TARGET VeroScript::Core)
		list(REMOVE_ITEM _vs_wanted PlatformBindings GraphicsBindings AudioBindings)
	endif()
	foreach(_vs_component IN LISTS _vs_wanted)
		set(VeroScriptVisual_FIND_REQUIRED_${_vs_component} TRUE)
	endforeach()
	set(VeroScriptVisual_FIND_COMPONENTS ${_vs_wanted})
endif()
if(GraphicsBindings IN_LIST _vs_wanted)
	list(APPEND _vs_wanted Graphics PlatformBindings)
endif()
if(PlatformBindings IN_LIST _vs_wanted)
	list(APPEND _vs_wanted Platform)
endif()
if(AudioBindings IN_LIST _vs_wanted)
	list(APPEND _vs_wanted Audio)
endif()
if(Sdl3 IN_LIST _vs_wanted)
	list(APPEND _vs_wanted Platform)
	if(@VEROSCRIPT_SDL3_AUDIO@)
		list(APPEND _vs_wanted Audio)
	endif()
	if(@VEROSCRIPT_SDL3_GRAPHICS@)
		list(APPEND _vs_wanted Graphics)
	endif()
endif()

set(VeroScriptVisual_FOUND TRUE)
foreach(_vs_component Platform Graphics Audio PlatformBindings GraphicsBindings AudioBindings Sdl3 Image Font Stb FontBackend)
	set(VeroScriptVisual_${_vs_component}_FOUND FALSE)
	if(NOT _vs_component IN_LIST _vs_wanted OR NOT _vs_component IN_LIST _vs_available)
		continue()
	endif()
	if(_vs_component MATCHES "Bindings$" AND NOT TARGET VeroScript::Core)
		set(VeroScriptVisual_NOT_FOUND_MESSAGE "Bindings require the matching Core SDK target VeroScript::Core")
		continue()
	endif()
	if(_vs_component STREQUAL "Sdl3")
		if(NOT TARGET SDL3::SDL3)
			find_package(SDL3 3.4.18 EXACT QUIET CONFIG)
		endif()
		find_package(Threads QUIET)
		if(NOT TARGET SDL3::SDL3 OR NOT Threads_FOUND)
			set(VeroScriptVisual_NOT_FOUND_MESSAGE "Sdl3 requires the matching SDL3 3.4.18 SDK and Threads")
			continue()
		endif()
	endif()
	if(_vs_component MATCHES "^(Image|Font|Stb|FontBackend)$")
		find_package(VeroScript${_vs_component} 0.1.1 EXACT QUIET CONFIG)
		if(NOT TARGET VeroScript::${_vs_component})
			set(VeroScriptVisual_NOT_FOUND_MESSAGE "${_vs_component} requires its matching SDK package")
			continue()
		endif()
	else()
		include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptVisual${_vs_component}Targets.cmake")
	endif()
	set(VeroScriptVisual_${_vs_component}_FOUND TRUE)
endforeach()
check_required_components(VeroScriptVisual)
unset(_vs_component)
unset(_vs_wanted)
unset(_vs_available)

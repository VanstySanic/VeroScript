function(vs_resolve_veroscript_root result repo)
	if(DEFINED VEROSCRIPT_MODULE_ROOT AND NOT VEROSCRIPT_MODULE_ROOT STREQUAL "")
		get_filename_component(root "${VEROSCRIPT_MODULE_ROOT}" ABSOLUTE BASE_DIR "${repo}")
	else()
		file(GLOB candidates LIST_DIRECTORIES true "${repo}/*/VeroScript")
		set(roots)
		if(IS_DIRECTORY "${repo}/VeroScript")
			list(APPEND roots "${repo}")
		endif()
		foreach(candidate IN LISTS candidates)
			if(IS_DIRECTORY "${candidate}")
				get_filename_component(candidate "${candidate}" DIRECTORY)
				list(APPEND roots "${candidate}")
			endif()
		endforeach()
		list(LENGTH roots count)
		if(NOT count EQUAL 1)
			message(FATAL_ERROR "Expected one VeroScript module; set VEROSCRIPT_MODULE_ROOT explicitly")
		endif()
		list(GET roots 0 root)
	endif()
	if(NOT IS_DIRECTORY "${root}/VeroScript")
		message(FATAL_ERROR "Invalid VeroScript module root: ${root}")
	endif()
	set(${result} "${root}" PARENT_SCOPE)
endfunction()

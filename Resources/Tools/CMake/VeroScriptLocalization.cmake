# Source ownership and deployment profiles are shared by native builds, wheels,
# Wasm embedding and the release scripts. Deployed catalogs keep their existing
# <culture>/<component>.json layout; source catalogs belong to their modules.
if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
	# Functions capture policies when defined, including CMP0057 for IN_LIST.
	cmake_minimum_required(VERSION 3.25)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptPaths.cmake")

function(vs_localization_roots result repo profile)
	vs_resolve_veroscript_root(module_root "${repo}")
	if(profile MATCHES "^(json|network|http|websocket|network-all)$")
		set(roots)
		if(profile STREQUAL "json")
			list(APPEND roots "${module_root}/Modules/Network/VeroScriptJson/Resources/Localization")
		endif()
		if(NOT profile STREQUAL "json")
			list(APPEND roots "${module_root}/Modules/Network/VeroScriptNetwork/Resources/Localization")
		endif()
		if(profile STREQUAL "http" OR profile STREQUAL "network-all")
			list(APPEND roots "${module_root}/Modules/Network/VeroScriptHttp/Resources/Localization")
		endif()
		if(profile STREQUAL "websocket" OR profile STREQUAL "network-all")
			list(APPEND roots "${module_root}/Modules/Network/VeroScriptWebSocket/Resources/Localization")
		endif()
		set(${result} "${roots}" PARENT_SCOPE)
		return()
	endif()
	set(roots "${module_root}/VeroScript/Resources/Localization")
	if(profile STREQUAL "cpp" OR profile STREQUAL "interop"
		OR profile STREQUAL "runtime" OR profile STREQUAL "python" OR profile STREQUAL "mobile")
		list(APPEND roots "${module_root}/Extensions/Language/Cpp/VeroScriptCpp/Resources/Localization")
	endif()
	if(profile STREQUAL "interop" OR profile STREQUAL "runtime" OR profile STREQUAL "python" OR profile STREQUAL "mobile")
		list(APPEND roots "${module_root}/VeroScriptInterop/Resources/Localization")
	endif()
	if(profile STREQUAL "tooling" OR profile STREQUAL "runtime")
		list(APPEND roots "${module_root}/VeroScriptTooling/Resources/Localization")
	endif()
	if(profile STREQUAL "python")
		list(APPEND roots "${module_root}/Extensions/Language/Python/Resources/Localization")
	elseif(profile STREQUAL "python-tools")
		set(roots "${module_root}/Extensions/Language/Python/Resources/Localization")
	elseif(NOT profile MATCHES "^(core|cpp|interop|tooling|runtime|mobile)$")
		message(FATAL_ERROR "Unknown VeroScript localization profile: ${profile}")
	endif()
	if(profile STREQUAL "python" OR profile STREQUAL "python-tools")
		foreach(module IN ITEMS Frontend BindGen Transpiler Aot)
			list(APPEND roots "${module_root}/Extensions/Language/Python/VeroScriptPython${module}/Resources/Localization")
		endforeach()
	endif()
	if(profile STREQUAL "mobile")
		list(APPEND roots "${module_root}/Extensions/Platform/Mobile/VeroScriptMobile/Resources/Localization")
	endif()
	set(${result} "${roots}" PARENT_SCOPE)
endfunction()

function(vs_stage_localization repo output profile)
	vs_resolve_veroscript_root(module_root "${repo}")
	vs_localization_roots(roots "${repo}" "${profile}")
	get_filename_component(output "${output}" ABSOLUTE)
	get_filename_component(output_name "${output}" NAME)
	string(TOLOWER "${output_name}" output_name)
	if(NOT output_name STREQUAL "localization" OR IS_SYMLINK "${output}")
		message(FATAL_ERROR "Expected an unlinked localization deployment directory: ${output}")
	endif()
	# Resolve the existing ancestor before appending a new destination. Besides
	# avoiding REAL_PATH warnings, this preserves source-overlap checks through
	# linked parents even before the output directory has been created.
	set(output_ancestor "${output}")
	set(output_parts)
	while(NOT EXISTS "${output_ancestor}")
		if(IS_SYMLINK "${output_ancestor}")
			message(FATAL_ERROR "Dangling localization deployment link: ${output_ancestor}")
		endif()
		get_filename_component(parent "${output_ancestor}" DIRECTORY)
		if(parent STREQUAL output_ancestor)
			message(FATAL_ERROR "Localization deployment has no existing ancestor: ${output}")
		endif()
		get_filename_component(part "${output_ancestor}" NAME)
		list(PREPEND output_parts "${part}")
		set(output_ancestor "${parent}")
	endwhile()
	file(REAL_PATH "${output_ancestor}" output)
	foreach(part IN LISTS output_parts)
		cmake_path(APPEND output "${part}")
	endforeach()
	file(GLOB_RECURSE existing_paths LIST_DIRECTORIES true "${output}/*")
	foreach(path IN LISTS existing_paths)
		if(IS_SYMLINK "${path}")
			message(FATAL_ERROR "Linked localization deployment entry: ${path}")
		endif()
	endforeach()
	vs_localization_roots(all_roots "${repo}" runtime)
	vs_localization_roots(python_roots "${repo}" python-tools)
	vs_localization_roots(network_roots "${repo}" network-all)
	vs_localization_roots(json_roots "${repo}" json)
	list(APPEND all_roots ${python_roots} ${network_roots} ${json_roots}
		"${module_root}/Extensions/Platform/Mobile/VeroScriptMobile/Resources/Localization"
		"${module_root}/VeroScriptInstaller/App/Resources/Localization")
	set(output_comparison "${output}")
	if(CMAKE_HOST_WIN32)
		string(TOLOWER "${output_comparison}" output_comparison)
	endif()
	foreach(root IN LISTS all_roots)
		if(EXISTS "${root}")
			file(REAL_PATH "${root}" source_root)
		else()
			get_filename_component(source_root "${root}" ABSOLUTE)
		endif()
		if(CMAKE_HOST_WIN32)
			string(TOLOWER "${source_root}" source_root)
		endif()
		cmake_path(IS_PREFIX output_comparison "${source_root}" NORMALIZE output_contains_source)
		cmake_path(IS_PREFIX source_root "${output_comparison}" NORMALIZE source_contains_output)
		if(output_contains_source OR source_contains_output)
			message(FATAL_ERROR "Localization deployment overlaps sources: ${output}")
		endif()
	endforeach()
	# Check every source before changing the destination. Never synchronize a
	# catalog over its own sources, and reject conflicting relative filenames.
	set(relative_files)
	set(source_files)
	foreach(root IN LISTS roots)
		if(NOT IS_DIRECTORY "${root}/en-US")
			message(FATAL_ERROR "Missing localization baseline: ${root}/en-US")
		endif()
		file(GLOB_RECURSE files RELATIVE "${root}" "${root}/*.json")
		foreach(relative IN LISTS files)
			if(relative IN_LIST relative_files)
				message(FATAL_ERROR "Conflicting localization file: ${relative}")
			endif()
			list(APPEND relative_files "${relative}")
			list(APPEND source_files "${root}/${relative}")
		endforeach()
	endforeach()
	file(GLOB_RECURSE deployed RELATIVE "${output}" "${output}/*.json")
	foreach(relative IN LISTS deployed)
		if(NOT relative IN_LIST relative_files)
			file(REMOVE "${output}/${relative}")
		endif()
	endforeach()
	list(LENGTH relative_files count)
	if(count GREATER 0)
		math(EXPR last "${count} - 1")
		foreach(index RANGE ${last})
			list(GET relative_files ${index} relative)
			list(GET source_files ${index} source)
			configure_file("${source}" "${output}/${relative}" COPYONLY)
		endforeach()
	endif()
	# Removed cultures and nested catalog directories must not remain as empty
	# cultures: the runtime deliberately rejects those. Only empty dirs are removed.
	file(GLOB_RECURSE deployed_dirs LIST_DIRECTORIES true "${output}/*")
	list(SORT deployed_dirs ORDER DESCENDING)
	foreach(directory IN LISTS deployed_dirs)
		if(IS_DIRECTORY "${directory}" AND NOT IS_SYMLINK "${directory}")
			file(GLOB children "${directory}/*" "${directory}/.*")
			if(NOT children)
				file(REMOVE_RECURSE "${directory}")
			endif()
		endif()
	endforeach()
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
	if(NOT DEFINED VEROSCRIPT_SOURCE_ROOT OR NOT DEFINED VEROSCRIPT_LOCALIZATION_OUTPUT
		OR NOT DEFINED VEROSCRIPT_LOCALIZATION_PROFILE)
		message(FATAL_ERROR "Source root, localization output and profile are required")
	endif()
	vs_stage_localization("${VEROSCRIPT_SOURCE_ROOT}" "${VEROSCRIPT_LOCALIZATION_OUTPUT}"
		"${VEROSCRIPT_LOCALIZATION_PROFILE}")
endif()

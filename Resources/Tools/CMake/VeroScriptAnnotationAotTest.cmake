function(require_success result label)
	if(NOT "${result}" STREQUAL "0")
		message(FATAL_ERROR "${label} failed: ${result}\n${out}\n${err}")
	endif()
endfunction()
if(KIND STREQUAL "cpp")
	file(MAKE_DIRECTORY "${WORK}/cpp")
	file(WRITE "${WORK}/cpp/CMakeLists.txt" "cmake_minimum_required(VERSION 3.25)\nproject(AnnotationAot LANGUAGES CXX)\nadd_executable(annotation ../generated.cpp)\ntarget_compile_features(annotation PRIVATE cxx_std_17)\n")
	set(generator_args -G "${GENERATOR}")
	if(PLATFORM)
		list(APPEND generator_args -A "${PLATFORM}")
	endif()
	execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}/cpp" -B "${WORK}/cpp/build" ${generator_args}
		RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
	require_success("${status}" "C++ configure")
	execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/cpp/build" --config Release
		RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
	require_success("${status}" "C++ compile")
	if(EXISTS "${WORK}/cpp/build/Release/annotation${EXE_SUFFIX}")
		set(command "${WORK}/cpp/build/Release/annotation${EXE_SUFFIX}")
	else()
		set(command "${WORK}/cpp/build/annotation${EXE_SUFFIX}")
	endif()
elseif(KIND STREQUAL "csharp")
	file(MAKE_DIRECTORY "${WORK}/csharp")
	file(COPY_FILE "${WORK}/generated.cs" "${WORK}/csharp/Program.cs")
	file(WRITE "${WORK}/csharp/Annotation.csproj" "<Project Sdk=\"Microsoft.NET.Sdk\"><PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings></PropertyGroup></Project>")
	execute_process(COMMAND "${DOTNET}" build "${WORK}/csharp/Annotation.csproj" --configuration Release --nologo -p:Platform=AnyCPU
		RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
	require_success("${status}" "C# compile")
	set(command "${DOTNET}" "${WORK}/csharp/bin/Release/net10.0/Annotation.dll")
elseif(KIND STREQUAL "python")
	set(command "${PYTHON}" "${WORK}/generated.py")
else()
	message(FATAL_ERROR "Unknown AOT kind")
endif()
execute_process(COMMAND ${command} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
require_success("${status}" "${KIND} execution")
string(REPLACE "\r\n" "\n" out "${out}")
set(expected "42\n15\nok\n3\n")
if(KIND STREQUAL "cpp")
	string(APPEND expected "11\n")
endif()
if(NOT out STREQUAL expected)
	message(FATAL_ERROR "${KIND} output mismatch: [${out}]\n${err}")
endif()

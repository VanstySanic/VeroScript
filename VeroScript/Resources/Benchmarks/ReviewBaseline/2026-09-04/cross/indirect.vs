int work(int limit) { array<int> values = array<int>(); array<int> indices = array<int>(); for (int i = 0; i < 257; i++) { values.push((i * 17 + 11) % 101); indices.push((i * 37 + 19) % 257); } int state = 17; int total = 0; for (int i = 0; i < limit; i++) { state = (state * 25173 + 13849) % 65521; int position = (state + ((i % 257) * 7)) % 257; int index = indices[position]; int delta = ((state / 7) % 13) + 1; values[index] = (values[index] + delta) % 1000003; total = (total + values[index] + (position & 3)) % 1000000007; } return (total + state + values[indices[state % 257]]) % 1000000007; } void main(){int checksum=0;for(int rep=0;rep<20;rep++){checksum=(checksum+work(100000))%1000000007;}print(checksum);}


interface IOperation { virtual int step(int value, int salt) = 0; }; class Add : IOperation { public: int step(int value, int salt) { return (value + 1 + (salt % 3)) % 1000000007; } }; class Xor : IOperation { public: int step(int value, int salt) { return ((value ^ (salt & 7)) + 7) % 1000000007; } }; int advance(int state) { return (state * 75 + 74) % 65521; } int work(int limit) { array<IOperation> operations = {Add(), Xor()}; array<int> order = {1,0,1,0}; int state = 17; int total = 0; for (int i=0; i<limit; i++) { state=advance(state); int index=order[(state+total)&3]; IOperation operation=operations[index]; total=operation.step(total,state); } return total+state; } void main(){int checksum=0;for(int rep=0;rep<20;rep++){checksum=(checksum+work(200000))%1000000007;}print(checksum);}


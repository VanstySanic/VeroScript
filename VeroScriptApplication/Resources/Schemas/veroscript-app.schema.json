{
  "type": "object",
  "properties": {
    "format": {
      "const": "veroscript-application"
    },
    "formatVersion": {
      "const": "0.1.1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "compiled-image",
            "source"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 511,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "packageName": {
          "type": "string",
          "minLength": 1
        },
        "packageVersion": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$",
          "maxLength": 20
        }
      },
      "required": [
        "kind",
        "path"
      ],
      "additionalProperties": false
    },
    "platform": {
      "oneOf": [
        {
          "const": "portable"
        },
        {
          "type": "object",
          "properties": {
            "core": {
              "type": "string",
              "minLength": 1
            },
            "coreBuild": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "arch": {
              "type": "string",
              "minLength": 1
            },
            "environment": {
              "type": "string",
              "minLength": 1
            },
            "abis": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "minimumVersions": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "core",
            "coreBuild",
            "os",
            "arch",
            "environment",
            "abis",
            "minimumVersions",
            "capabilities"
          ],
          "additionalProperties": false
        }
      ]
    },
    "requirements": {
      "type": "object",
      "properties": {
        "coreVersion": {
          "const": "0.1.1"
        },
        "coreBuild": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "coreVersion",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "external",
            "bundled"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 511,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "external",
            "bundled"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 511,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "ownerId": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 511,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "moduleIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "path"
        ],
        "additionalProperties": false
      }
    },
    "files": {
      "const": "veroscript-app.files.json"
    },
    "extensions": {
      "type": "object"
    },
    "modules": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 511,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "compile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defines": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string"
          }
        },
        "implicitImports": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 511,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          }
        },
        "allowCircularImports": {
          "type": "boolean"
        },
        "allowProjectWideAccess": {
          "type": "boolean"
        },
        "predefinedMacros": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "parameters",
              "variadic",
              "body",
              "sourceName"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "parameters": {
                "type": "array",
                "maxItems": 4096,
                "items": {
                  "type": "string"
                }
              },
              "variadic": {
                "type": "boolean"
              },
              "body": {
                "type": "string"
              },
              "sourceName": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "version",
    "entry",
    "platform",
    "requirements",
    "runtime",
    "environment",
    "services",
    "resources",
    "files",
    "extensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VeroScript application 0.1.1",
  "allOf": [
    {
      "if": {
        "required": [
          "compile"
        ]
      },
      "then": {
        "properties": {
          "entry": {
            "properties": {
              "kind": {
                "const": "source"
              }
            }
          }
        }
      }
    }
  ]
}

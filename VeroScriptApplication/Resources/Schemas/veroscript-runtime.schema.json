{
  "type": "object",
  "properties": {
    "format": {
      "const": "veroscript-runtime"
    },
    "formatVersion": {
      "const": "0.1.1"
    },
    "applicationProtocol": {
      "const": "0.1.1"
    },
    "target": {
      "type": "object",
      "properties": {
        "core": {
          "type": "string",
          "minLength": 1
        },
        "coreBuild": {
          "type": "string",
          "minLength": 1
        },
        "os": {
          "type": "string",
          "minLength": 1
        },
        "arch": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "abis": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "minimumVersions": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "core",
        "coreBuild",
        "os",
        "arch",
        "environment",
        "abis",
        "minimumVersions",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "executable": {
      "type": "string",
      "minLength": 1,
      "maxLength": 511,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "stdlib": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 511,
        "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 511,
            "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$",
            "maxLength": 20
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "mode": {
            "enum": [
              "0644",
              "0755"
            ]
          }
        },
        "required": [
          "path",
          "bytes",
          "sha256",
          "mode"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "applicationProtocol",
    "target",
    "executable",
    "stdlib",
    "files",
    "extensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}

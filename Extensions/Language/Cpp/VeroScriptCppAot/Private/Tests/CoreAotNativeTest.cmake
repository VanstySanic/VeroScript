file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${EMITTER}" "${WORK}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "Core AOT emitter failed: ${result}")
endif()
configure_file("${CONSUMER}" "${WORK}/main.cpp" COPYONLY)
file(WRITE "${WORK}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.21)\nproject(CoreAotConsumer LANGUAGES CXX)\nset(CMAKE_CXX_STANDARD_REQUIRED ON)\nset(CMAKE_CXX_EXTENSIONS OFF)\nfind_package(Threads REQUIRED)\nadd_executable(native main.cpp generated.cpp)\ntarget_include_directories(native PRIVATE [=[${INCLUDES}]=] [=[${GENERATED}]=] [=[${VM_INCLUDE}]=])\ntarget_link_libraries(native PRIVATE [=[${CORE}]=] [=[${VM_STATIC}]=] Threads::Threads \${CMAKE_DL_LIBS})\nif(MSVC)\n target_compile_options(native PRIVATE /utf-8 /W4 /WX)\nelse()\n target_compile_options(native PRIVATE -Wall -Wextra -Werror)\nendif()\n")
if(INTEROP)
	file(APPEND "${WORK}/CMakeLists.txt" "add_executable(interop main.cpp generated.cpp)\ntarget_compile_definitions(interop PRIVATE VEROSCRIPT_AOT_WITH_INTEROP=1)\ntarget_include_directories(interop PRIVATE [=[${INCLUDES}]=] [=[${GENERATED}]=] [=[${INTEROP_INCLUDE}]=])\ntarget_link_libraries(interop PRIVATE [=[${INTEROP}]=])\nif(MSVC)\n target_compile_options(interop PRIVATE /utf-8 /W4 /WX)\nelse()\n target_compile_options(interop PRIVATE -Wall -Wextra -Werror)\nendif()\n")
endif()
if(MOBILE AND INTEROP)
	file(APPEND "${WORK}/CMakeLists.txt" "target_compile_definitions(interop PRIVATE VEROSCRIPT_AOT_WITH_MOBILE=1)\ntarget_include_directories(interop PRIVATE [=[${MOBILE_INCLUDE}]=])\ntarget_link_libraries(interop PRIVATE [=[${MOBILE}]=])\n")
endif()
set(platform_args)
if(PLATFORM)
	list(APPEND platform_args -A "${PLATFORM}")
endif()
if(TOOLSET)
	list(APPEND platform_args -T "${TOOLSET}")
endif()
# The native consumer shares Core's C++ service ABI and runtime configuration.
if(NOT CXX_STANDARD)
	set(CXX_STANDARD 17)
endif()
set(consumer_args)
foreach(setting IN ITEMS CXX_COMPILER OSX_SYSROOT OSX_ARCHITECTURES OSX_DEPLOYMENT_TARGET)
	# Also reset empty values so an older consumer cache cannot select a
	# different Apple SDK or runtime than the producer.
	if(DEFINED ${setting})
		string(REPLACE ";" "\\;" value "${${setting}}")
		list(APPEND consumer_args "-DCMAKE_${setting}=${value}")
	endif()
endforeach()
if(MSVC_RUNTIME_LIBRARY_SET OR MSVC_RUNTIME_LIBRARY)
	list(APPEND consumer_args "-DCMAKE_MSVC_RUNTIME_LIBRARY=${MSVC_RUNTIME_LIBRARY}")
elseif(DEFINED MSVC_RUNTIME_LIBRARY)
	# Preserve an explicitly empty property above; an unset one uses CMake's default.
	list(APPEND consumer_args "-UCMAKE_MSVC_RUNTIME_LIBRARY")
endif()
# --config only selects a configuration for multi-config generators.
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}" -B "${WORK}/build" -G "${GENERATOR}"
	"-DCMAKE_BUILD_TYPE=${CONFIG}" "-DCMAKE_CXX_STANDARD=${CXX_STANDARD}"
	${platform_args} ${consumer_args} RESULT_VARIABLE result)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "Core AOT consumer configuration failed")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" --config "${CONFIG}" --parallel 2 RESULT_VARIABLE result)
if(NOT result EQUAL 0)
	message(FATAL_ERROR "Generated Core AOT native compilation failed")
endif()
set(bin "${WORK}/build")
if(EXISTS "${bin}/${CONFIG}/native${EXE_SUFFIX}")
	string(APPEND bin "/${CONFIG}")
endif()
if(WIN32 AND INTEROP_RUNTIME)
	file(COPY "${INTEROP_RUNTIME}" DESTINATION "${bin}")
endif()
foreach(consumer IN ITEMS native interop)
	if(consumer STREQUAL interop AND NOT INTEROP)
		continue()
	endif()
	execute_process(COMMAND "${bin}/${consumer}${EXE_SUFFIX}" "${WORK}/program.vsbc" "${WORK}/program.vsapp" RESULT_VARIABLE result)
	if(NOT result EQUAL 0)
		message(FATAL_ERROR "Generated Core AOT ${consumer} execution failed: ${result}")
	endif()
endforeach()

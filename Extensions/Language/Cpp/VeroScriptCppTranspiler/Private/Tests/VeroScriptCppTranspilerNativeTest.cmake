function(require_success label)
	if(NOT status STREQUAL "0")
		message(FATAL_ERROR "${label}: ${status}\n${out}\n${err}")
	endif()
endfunction()
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND "${TEST_EXE}" "${WORK}/generated.cpp"
	RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
require_success("C++ project transpile/VM/AOT pipeline")
file(WRITE "${WORK}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.25)\nproject(TranspiledNative LANGUAGES CXX)\nadd_executable(native generated.cpp)\nadd_executable(numeric numeric.cpp)\ntarget_compile_features(native PRIVATE cxx_std_17)\ntarget_compile_features(numeric PRIVATE cxx_std_17)\n")
set(generator_args -G "${GENERATOR}")
if(PLATFORM)
	list(APPEND generator_args -A "${PLATFORM}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}" -B "${WORK}/build" ${generator_args}
	RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
require_success("Native configure")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" --config Release
	RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
require_success("Native compile")
set(executable "${WORK}/build/native${EXE_SUFFIX}")
if(EXISTS "${WORK}/build/Release/native${EXE_SUFFIX}")
	set(executable "${WORK}/build/Release/native${EXE_SUFFIX}")
endif()
execute_process(COMMAND "${executable}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
require_success("Native execution")
string(REPLACE "\r\n" "\n" out "${out}")
if(NOT out STREQUAL "43\n7\n45\n43\n44\n46\n")
	message(FATAL_ERROR "Native output differs from VM: ${out}\n${err}")
endif()
set(executable "${WORK}/build/numeric${EXE_SUFFIX}")
if(EXISTS "${WORK}/build/Release/numeric${EXE_SUFFIX}")
	set(executable "${WORK}/build/Release/numeric${EXE_SUFFIX}")
endif()
execute_process(COMMAND "${executable}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
require_success("Native numeric execution")
string(REPLACE "\r\n" "\n" out "${out}")
if(NOT out STREQUAL "true\ntrue\ntrue\ntrue\n1\n1\n2\n3\n4\n63\n15\n4294967295\n0\n1\n1\n-9223372036854775808\n9223372036854775807\n-2147483648\n")
	message(FATAL_ERROR "Native numeric output differs from VM: ${out}\n${err}")
endif()

from collections.abc import Callable as CallableType, Iterable, Iterator, Mapping
import sys
from typing import Any, final, type_check_only

if sys.version_info >= (3, 12):
	from collections.abc import Buffer
else:
	from typing_extensions import Buffer

if sys.version_info >= (3, 15):
	from typing import disjoint_base
else:
	from typing_extensions import disjoint_base

class Error(RuntimeError): ...
class ThreadError(Error): ...
class TypeMismatchError(Error): ...
class CallbackError(Error): ...

@final
class MemoryLease(Buffer):
	if sys.version_info >= (3, 12):
		def __buffer__(self, flags: int, /) -> memoryview: ...
		def __release_buffer__(self, buffer: memoryview, /) -> None: ...
	else:
		# CPython 3.11 exposes this protocol through C slots only.
		@type_check_only
		def __buffer__(self, flags: int, /) -> memoryview: ...
	@property
	def size(self) -> int: ...
	@property
	def closed(self) -> bool: ...
	@property
	def writable(self) -> bool: ...
	def close(self) -> None: ...
	def __enter__(self) -> MemoryLease: ...
	def __exit__(self, exc_type: object, exc_value: object, traceback: object) -> None: ...

@disjoint_base
class Value:
	def __init__(
		self,
		value: object = ...,
		kind: str | None = ...,
		type_name: str | None = ...,
	) -> None: ...
	@classmethod
	def empty_variant(cls) -> Value: ...
	def set_variant_empty(self) -> None: ...
	def assign_variant(self, source: Value, /) -> None: ...
	def variant_has_value(self) -> bool: ...
	def variant_type_name(self) -> str: ...
	def variant_get(self) -> Value: ...
	@classmethod
	def array(cls, element_type: str, elements: Iterable[object]) -> Value: ...
	@classmethod
	def queue(cls, element_type: str, elements: Iterable[object]) -> Value: ...
	@classmethod
	def priority_queue(cls, element_type: str, elements: Iterable[object]) -> Value: ...
	@classmethod
	def stack(cls, element_type: str, elements: Iterable[object]) -> Value: ...
	@classmethod
	def deque(cls, element_type: str, elements: Iterable[object]) -> Value: ...
	@classmethod
	def channel(cls, element_type: str, capacity: int = ...) -> Value: ...
	@classmethod
	def set(cls, element_type: str, elements: Iterable[object]) -> Value: ...
	@classmethod
	def map(
		cls,
		key_type: str,
		value_type: str,
		mapping: Mapping[object, object],
		ordered: bool = ...,
	) -> Value: ...
	def clone(self) -> Value: ...
	def to_python(self) -> object: ...
	def __len__(self) -> int: ...
	def __iter__(self) -> Iterator[object]: ...
	def __getitem__(self, key: object, /) -> object: ...
	def __contains__(self, element: object, /) -> bool: ...
	def get(self, key: object, default: object = ...) -> object: ...
	def contains(self, element: object, /) -> bool: ...
	def keys(self) -> list[object]: ...
	def values(self) -> list[object]: ...
	def items(self) -> list[tuple[object, object]]: ...
	def send(self, value: object, /) -> None: ...
	def try_send(self, value: object, /) -> bool: ...
	def send_for(self, value: object, timeout_ms: int, /) -> bool: ...
	def receive(self) -> object: ...
	def try_receive(self) -> object | None: ...
	def receive_for(self, timeout_ms: int, /) -> object | None: ...
	def close_channel(self) -> None: ...
	value: object
	@property
	def kind(self) -> str: ...
	@property
	def numeric_kind(self) -> int: ...
	@property
	def type_name(self) -> str: ...
	@property
	def count(self) -> int: ...
	@property
	def channel_capacity(self) -> int: ...
	@property
	def channel_closed(self) -> bool: ...

@disjoint_base
class Package:
	def __init__(self, data: Buffer) -> None: ...
	@property
	def kind(self) -> int: ...
	@property
	def name(self) -> str: ...
	@property
	def version(self) -> int: ...
	@property
	def metadata(self) -> dict[str, bytes]: ...
	@property
	def canonical_signed_bytes(self) -> bytes: ...

@final
class Callable:
	def invoke(self, *arguments: object) -> tuple[object, dict[str, Any]]: ...
	def __call__(self, *arguments: object) -> tuple[object, dict[str, Any]]: ...
	def close(self) -> None: ...
	@property
	def closed(self) -> bool: ...
	@property
	def is_valid(self) -> bool: ...


<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12.0</LangVersion>
		<RootNamespace>VeroScript.CSharpBindGen</RootNamespace>
		<AssemblyName>VeroScriptCSharpBindGen</AssemblyName>
		<VersionPrefix>0.1.1</VersionPrefix>
		<PackageId>VeroScript.CSharpBindGen</PackageId>
		<Title>VeroScript C# Binding Generator</Title>
		<Description>Generates VeroScript binding catalog metadata from C# declarations.</Description>
		<Authors>VanstySanic</Authors>
		<Company>VanstySanic</Company>
		<Copyright>Copyright © 2026 VanstySanic</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/VanstySanic/VeroScript/tree/main/Extensions/Language/CSharp/VeroScriptCSharpBindGen</PackageProjectUrl>
		<RepositoryUrl>https://github.com/VanstySanic/VeroScript</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryCommit Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageTags>veroscript;csharp;bindgen;bindings;code-generation;nativeaot</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>Binding Catalog, live registration, and reflection-free C# AOT bridge generation.</PackageReleaseNotes>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>9.0-recommended</AnalysisLevel>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnablePackageValidation>true</EnablePackageValidation>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<ProjectReference Include="..\VeroScriptCSharpFrontend\VeroScriptCSharpFrontend.csproj" />
		<Compile Remove="Tests\**\*.cs" />
		<Compile Remove="Cli\**\*.cs" />
		<Compile Remove="Resources\Examples\**\*.cs" />
		<None Include="Tests\**\*" />
		<None Include="Cli\**\*" />
		<None Include="Resources\Examples\**\*" />
		<None Remove="README.md" />
		<None Include="..\..\..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>12.0</LangVersion>
		<RootNamespace>VeroScript.CSharpFrontend</RootNamespace>
		<AssemblyName>VeroScriptCSharpFrontend</AssemblyName>
		<VersionPrefix>0.1.1</VersionPrefix>
		<Title>VeroScript C# Frontend</Title>
		<Description>Stable declaration model and semantic C# frontend for VeroScript tooling.</Description>
		<PackageId>VeroScript.CSharpFrontend</PackageId>
		<Authors>VanstySanic</Authors>
		<Company>VanstySanic</Company>
		<Copyright>Copyright © 2026 VanstySanic</Copyright>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/VanstySanic/VeroScript/tree/main/Extensions/Language/CSharp/VeroScriptCSharpFrontend</PackageProjectUrl>
		<RepositoryUrl>https://github.com/VanstySanic/VeroScript</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<RepositoryCommit Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</RepositoryCommit>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<PackageTags>veroscript;csharp;frontend;roslyn;tooling</PackageTags>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageReleaseNotes>Roslyn-backed semantic C# frontend and stable VeroScript-owned declaration model.</PackageReleaseNotes>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Deterministic>true</Deterministic>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>9.0-recommended</AnalysisLevel>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<EnablePackageValidation>true</EnablePackageValidation>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.13.0" />
		<Compile Remove="Tests\**\*.cs" />
		<None Include="Tests\**\*" />
		<None Remove="README.md" />
		<None Include="..\..\..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
		<None Include="..\Resources\Licenses\Roslyn-*" Link="licenses/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Pack="true" PackagePath="licenses/%(Filename)%(Extension)" />
	</ItemGroup>
</Project>

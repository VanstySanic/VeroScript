{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-msvc-ide-base",
      "hidden": true,
      "inherits": "base",
      "architecture": "x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-msvc-x64"
        },
        "jetbrains.com/clion": {
          "toolchain": "Default"
        }
      }
    },
    {
      "name": "windows-msvc-vs2026",
      "displayName": "Windows MSVC VS 2026",
      "inherits": "windows-msvc-ide-base",
      "generator": "Visual Studio 18 2026"
    },
    {
      "name": "windows-msvc-vs2022",
      "displayName": "Windows MSVC VS 2022",
      "inherits": "windows-msvc-ide-base",
      "generator": "Visual Studio 17 2022"
    },
    {
      "name": "windows-msvc-vs2019",
      "displayName": "Windows MSVC VS 2019",
      "inherits": "windows-msvc-ide-base",
      "generator": "Visual Studio 16 2019"
    },
    {
      "name": "windows-ninja-msvc",
      "displayName": "Windows Ninja MSVC",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_VS_PLATFORM_NAME": "x64"
      },
      "vendor": {
        "jetbrains.com/clion": {
          "toolchain": "Default"
        }
      }
    },
    {
      "name": "windows-ninja-clang",
      "displayName": "Windows Ninja Clang",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_VS_PLATFORM_NAME": "x64"
      }
    },
    {
      "name": "linux-ninja",
      "displayName": "Linux Ninja",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-ninja",
      "displayName": "macOS Ninja",
      "inherits": "base",
      "generator": "Ninja",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-ninja-msvc-release",
      "displayName": "Windows Ninja MSVC Release",
      "inherits": "windows-ninja-msvc",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-ninja-clang-release",
      "displayName": "Windows Ninja Clang Release",
      "inherits": "windows-ninja-clang",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-ninja-release",
      "displayName": "Linux Ninja Release",
      "inherits": "linux-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-ninja-release",
      "displayName": "macOS Ninja Release",
      "inherits": "macos-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "windows-msvc-vs2026-arm64",
      "displayName": "Windows ARM64 MSVC VS 2026",
      "inherits": "windows-msvc-vs2026",
      "architecture": "ARM64",
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-msvc-arm64"
        }
      }
    },
    {
      "name": "windows-msvc-vs2022-arm64",
      "displayName": "Windows ARM64 MSVC VS 2022",
      "inherits": "windows-msvc-vs2022",
      "architecture": "ARM64",
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-msvc-arm64"
        }
      }
    },
    {
      "name": "windows-msvc-vs2019-arm64",
      "displayName": "Windows ARM64 MSVC VS 2019",
      "inherits": "windows-msvc-vs2019",
      "architecture": "ARM64",
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [
            "Windows"
          ],
          "intelliSenseMode": "windows-msvc-arm64"
        }
      }
    }
  ],

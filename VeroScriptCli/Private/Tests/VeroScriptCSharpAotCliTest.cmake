cmake_minimum_required(VERSION 3.25)

foreach(_required IN ITEMS VERO_CLI VERO_WORK)
	if(NOT DEFINED ${_required} OR "${${_required}}" STREQUAL "")
		message(FATAL_ERROR "${_required} is required")
	endif()
endforeach()

file(REMOVE_RECURSE "${VERO_WORK}")
file(MAKE_DIRECTORY "${VERO_WORK}")
set(_source "${VERO_WORK}/hello.vs")
set(_output "${VERO_WORK}/Program.cs")
set(_default_output "${VERO_WORK}/Program.cpp")
file(WRITE "${_source}"
	"int square(int value) { return value * value; }\n"
	"void main() { print(\"你好，世界\"); print(square(6)); }\n")

execute_process(
	COMMAND "${VERO_CLI}" aot --target=csharp "${_source}" -o "${_output}"
	RESULT_VARIABLE _result
	OUTPUT_VARIABLE _stdout
	ERROR_VARIABLE _stderr)
if(NOT _result EQUAL 0)
	message(FATAL_ERROR
		"C# AOT CLI failed (${_result})\nstdout:\n${_stdout}\nstderr:\n${_stderr}")
endif()
if(NOT EXISTS "${_output}")
	message(FATAL_ERROR "C# AOT CLI did not create ${_output}")
endif()
file(READ "${_output}" _generated)
foreach(_fragment IN ITEMS
	"Generated by VeroScriptCSharpAot 0.1.1"
	"private static int Vs_S6_square_M_"
	"你好，世界"
	"public static int Main(string[] args)")
	string(FIND "${_generated}" "${_fragment}" _position)
	if(_position EQUAL -1)
		message(FATAL_ERROR "Generated C# is missing: ${_fragment}")
	endif()
endforeach()

set(_binding_source "${VERO_WORK}/binding.vs")
set(_binding_catalog "${VERO_WORK}/bindings.json")
set(_binding_output "${VERO_WORK}/BindingProgram.cs")
file(WRITE "${_binding_source}"
	"void main() { print(host_add(2)); }\n")
file(WRITE "${_binding_catalog}" [=[
{"version":1,"functions":[{"name":"host_add","returnType":"int","paramTypes":["int"]}],"genericTypeTemplates":[],"types":[],"typeAliases":[],"genericTypes":[]}
]=])
execute_process(
	COMMAND "${VERO_CLI}" aot --target=csharp "${_binding_source}"
		--binding-catalog "${_binding_catalog}" -o "${_binding_output}"
	RESULT_VARIABLE _binding_result
	OUTPUT_VARIABLE _binding_stdout
	ERROR_VARIABLE _binding_stderr)
if(NOT _binding_result EQUAL 0)
	message(FATAL_ERROR
		"C# AOT binding-catalog CLI failed (${_binding_result})\nstdout:\n${_binding_stdout}\nstderr:\n${_binding_stderr}")
endif()
file(READ "${_binding_output}" _binding_generated)
foreach(_binding_fragment IN ITEMS "Host-call contracts" "private static partial int VsHost_")
	string(FIND "${_binding_generated}" "${_binding_fragment}" _binding_position)
	if(_binding_position EQUAL -1)
		message(FATAL_ERROR "C# AOT binding output is missing: ${_binding_fragment}")
	endif()
endforeach()

# Keep the legacy no-target invocation pinned to C++ while adding C# selection.
execute_process(
	COMMAND "${VERO_CLI}" aot "${_source}" -o "${_default_output}"
	RESULT_VARIABLE _default_result
	OUTPUT_VARIABLE _default_stdout
	ERROR_VARIABLE _default_stderr)
if(NOT _default_result EQUAL 0)
	message(FATAL_ERROR
		"Default AOT CLI failed (${_default_result})\nstdout:\n${_default_stdout}\nstderr:\n${_default_stderr}")
endif()
file(READ "${_default_output}" _default_generated)
string(FIND "${_default_generated}" "Generated by VeroScriptCppAot 0.1.1" _cpp_position)
if(_cpp_position EQUAL -1)
	message(FATAL_ERROR "AOT CLI default target is no longer C++")
endif()

set(_bundle_dir "${VERO_WORK}/bundle")
execute_process(
	COMMAND "${VERO_CLI}" aot --target=csharp "${_source}"
		--output-dir "${_bundle_dir}" --bundle-name HelloBundle
	RESULT_VARIABLE _bundle_result
	OUTPUT_VARIABLE _bundle_stdout
	ERROR_VARIABLE _bundle_stderr)
if(NOT _bundle_result EQUAL 0)
	message(FATAL_ERROR
		"C# AOT bundle CLI failed (${_bundle_result})\nstdout:\n${_bundle_stdout}\nstderr:\n${_bundle_stderr}")
endif()
foreach(_bundle_file IN ITEMS
	HelloBundle.csproj
	HelloBundle.runtime.g.cs
	HelloBundle.program.g.cs
	HelloBundle.entry.g.cs
	HelloBundle.manifest.json)
	if(NOT EXISTS "${_bundle_dir}/${_bundle_file}")
		message(FATAL_ERROR "C# AOT bundle is missing ${_bundle_file}")
	endif()
endforeach()
file(READ "${_bundle_dir}/HelloBundle.manifest.json" _manifest)
string(FIND "${_manifest}" "veroscript.csharp-aot-source-bundle" _manifest_kind)
string(FIND "${_manifest}" "HelloBundle.entry.g.cs" _manifest_entry)
if(_manifest_kind EQUAL -1 OR _manifest_entry EQUAL -1)
	message(FATAL_ERROR "C# AOT bundle manifest is incomplete")
endif()

set(_binding_bundle_dir "${VERO_WORK}/binding-bundle")
execute_process(
	COMMAND "${VERO_CLI}" aot --target=csharp "${_binding_source}"
		--binding-catalog "${_binding_catalog}"
		--output-dir "${_binding_bundle_dir}" --bundle-name BindingBundle
	RESULT_VARIABLE _binding_bundle_result
	OUTPUT_VARIABLE _binding_bundle_stdout
	ERROR_VARIABLE _binding_bundle_stderr)
if(NOT _binding_bundle_result EQUAL 0)
	message(FATAL_ERROR
		"C# AOT binding bundle CLI failed (${_binding_bundle_result})\nstdout:\n${_binding_bundle_stdout}\nstderr:\n${_binding_bundle_stderr}")
endif()
file(READ "${_binding_bundle_dir}/BindingBundle.runtime.g.cs" _binding_runtime)
string(FIND "${_binding_runtime}" "Host-call contracts" _binding_contract_position)
if(_binding_contract_position EQUAL -1)
	message(FATAL_ERROR "C# AOT binding bundle lost host-call contracts")
endif()

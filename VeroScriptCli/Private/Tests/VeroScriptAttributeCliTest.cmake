file(MAKE_DIRECTORY "${WORK}")
# The build may use a junction to keep MSVC paths short; application inputs
# must use the actual temporary directory, like installed consumers do.
file(REAL_PATH "${WORK}" WORK)
function(run)
	execute_process(COMMAND "${VERO_CLI}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
	if(NOT status EQUAL 0)
		message(FATAL_ERROR "attribute CLI failed (${status}): ${ARGN}\n${out}\n${err}")
	endif()
endfunction()
set(backends vm mixed)
if(VERO_JIT_BACKEND)
	list(APPEND backends jit)
	set(jit_arg "--jit-backend=${VERO_JIT_BACKEND}")
endif()
foreach(sample attribute_demo attribute_functions attribute_methods attribute_weak)
	foreach(backend IN LISTS backends)
		run(${jit_arg} "--backend=${backend}" --bc-cache=off "${EXAMPLES}/${sample}.vs")
	endforeach()
endforeach()
file(WRITE "${WORK}/library.vs" "export import \"attribute.vs\";\nexport attribute<T> copied<T>(T value){return attribute<T>(value);}\n")
file(WRITE "${WORK}/consumer.vs" "import \"library.vslib\";\nclass Model{public:int read() const{return 5;}};\nint main(){Model model=Model();auto a=std::make_attribute_by_name<int>(model,\"read\");assert(a()==5);auto b=copied(7);assert(b()==7);auto w=std::make_weak_attribute_by_name<int>(weak<Model>(model),\"read\");assert(w()==5);return 0;}\n")
run(--emit-package "${WORK}/library.vslib" --strip-package-debug "${WORK}/library.vs")
run(--bc-cache=off "${WORK}/consumer.vs")
run(--bc-cache=on --bc-cache-dir "${WORK}/cache" "${WORK}/consumer.vs")
run(--bc-cache=on --bc-cache-dir "${WORK}/cache" "${WORK}/consumer.vs")
run(--emit-package "${WORK}/app.vsapp" --strip-package-debug "${WORK}/consumer.vs")
foreach(backend IN LISTS backends)
	run(${jit_arg} "--backend=${backend}" "${WORK}/app.vsapp")
endforeach()
# Libraries that share the standard-library dependency retain one component
# identity, including compiled specializations and open generic declarations.
file(WRITE "${WORK}/shared-stdlib.vs" "export import \"attribute.vs\";\n")
run(--emit-package "${WORK}/shared-stdlib.vslib" --strip-package-debug "${WORK}/shared-stdlib.vs")
foreach(pair "first|13" "second|17")
	string(REPLACE "|" ";" fields "${pair}")
	list(GET fields 0 name)
	list(GET fields 1 value)
	file(WRITE "${WORK}/${name}.vs" "export import \"shared-stdlib.vslib\";\nexport attribute<int> ${name}(){return attribute<int>(${value});}\n")
	run(--emit-package "${WORK}/${name}.vslib" --strip-package-debug "${WORK}/${name}.vs")
endforeach()
file(WRITE "${WORK}/shared-consumer.vs" "import \"shared-stdlib.vslib\";\nimport \"first.vslib\";\nimport \"second.vslib\";\nclass Model{public:int read()const{return 5;}};\nint main(){auto a=first();auto b=second();assert(a()==13 && b()==17);Model m=Model();auto c=std::make_attribute_by_name<int>(m,\"read\");assert(c()==5);return 0;}\n")
run(--bc-cache=off "${WORK}/shared-consumer.vs")
run(--emit-package "${WORK}/shared-app.vsapp" --strip-package-debug "${WORK}/shared-consumer.vs")
foreach(backend IN LISTS backends)
	run(${jit_arg} "--backend=${backend}" "${WORK}/shared-app.vsapp")
endforeach()

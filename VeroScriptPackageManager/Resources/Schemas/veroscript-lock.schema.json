{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact resolved graph 0.1.1",
  "type": "object",
  "properties": {
    "format": {
      "const": "veroscript-lock"
    },
    "formatVersion": {
      "const": "0.1.1"
    },
    "target": {
      "$ref": "veroscript-target.schema.json"
    },
    "development": {
      "type": "boolean"
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "api": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "api"
        ],
        "additionalProperties": false
      }
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "description": "SemVer major.minor.patch, optional prerelease, no build metadata."
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "registry",
                  "directory",
                  "archive",
                  "url"
                ]
              },
              "id": {
                "type": "string"
              },
              "alias": {
                "type": "string"
              },
              "api": {
                "type": "string"
              },
              "location": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "ownerId": {
            "type": "string"
          },
          "usage": {
            "type": "array",
            "items": {
              "enum": [
                "runtime",
                "compile",
                "development"
              ]
            },
            "uniqueItems": true
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "uniqueItems": true
          },
          "artifact": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "manifestSha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "kind": {
                "enum": [
                  "directory",
                  "archive"
                ]
              },
              "target": {
                "type": "object",
                "properties": {
                  "os": {
                    "type": "string"
                  },
                  "arch": {
                    "type": "string"
                  },
                  "environment": {
                    "type": "string"
                  },
                  "abis": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "coreBuild": {
                    "type": "string"
                  },
                  "minimumVersions": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "description": "SemVer major.minor.patch, optional prerelease, no build metadata."
                    }
                  },
                  "capabilities": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "requires": {
                "type": "object",
                "properties": {
                  "core": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Exact SemVer or whitespace-separated comparisons (< <= > >= =), intersected."
                  },
                  "features": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Exact SemVer or whitespace-separated comparisons (< <= > >= =), intersected."
                        }
                      },
                      "required": [
                        "id",
                        "version"
                      ],
                      "additionalProperties": false
                    },
                    "uniqueItems": true
                  }
                },
                "required": [],
                "additionalProperties": false
              },
              "blocked": {
                "type": "boolean"
              },
              "signatures": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "const": "veroscript-artifact-signature"
                    },
                    "formatVersion": {
                      "const": "0.1.1"
                    },
                    "algorithm": {
                      "type": "string",
                      "minLength": 1
                    },
                    "kind": {
                      "const": "distribution"
                    },
                    "bytes": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)$",
                      "maxLength": 20
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "keyId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "keyVersion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "signature": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "format",
                    "formatVersion",
                    "algorithm",
                    "kind",
                    "bytes",
                    "sha256",
                    "keyId",
                    "keyVersion",
                    "signature"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "sha256",
              "manifestSha256",
              "size"
            ],
            "additionalProperties": false
          },
          "manifest": {
            "$ref": "veroscript-package.schema.json"
          }
        },
        "required": [
          "name",
          "version",
          "source",
          "ownerId",
          "usage",
          "dependencies",
          "artifact",
          "manifest"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "requirementsFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "target",
    "development",
    "sources",
    "packages",
    "requirementsFingerprint"
  ],
  "additionalProperties": false
}

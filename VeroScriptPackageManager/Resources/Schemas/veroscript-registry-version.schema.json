{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registry version response 0.1.1",
  "type": "object",
  "properties": {
    "format": {
      "const": "veroscript-registry-version"
    },
    "formatVersion": {
      "const": "0.1.1"
    },
    "sourceId": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "description": "SemVer major.minor.patch, optional prerelease, no build metadata."
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "minLength": 1,
            "description": "Exact SemVer or whitespace-separated comparisons (< <= > >= =), intersected."
          },
          "source": {
            "type": "string"
          },
          "usage": {
            "type": "array",
            "items": {
              "enum": [
                "runtime",
                "compile",
                "development"
              ]
            },
            "uniqueItems": true
          },
          "optional": {
            "type": "boolean"
          },
          "when": {
            "type": "object",
            "properties": {
              "os": {
                "type": "string"
              },
              "arch": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "archive": {
            "type": "string"
          },
          "directory": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "version"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "description": "Exact SemVer or whitespace-separated comparisons (< <= > >= =), intersected."
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "not": {
              "anyOf": [
                {
                  "enum": [
                    ".",
                    ".."
                  ]
                },
                {
                  "pattern": "[^A-Za-z0-9._-]"
                }
              ]
            },
            "description": "Opaque stable ID using only ASCII letters, digits, dot, underscore and hyphen; not dot or dot-dot. Registry artifacts are ZIP archives; no kind field is used."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "manifestSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "target": {
            "type": "object",
            "properties": {
              "os": {
                "type": "string"
              },
              "arch": {
                "type": "string"
              },
              "environment": {
                "type": "string"
              },
              "abis": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "coreBuild": {
                "type": "string"
              },
              "minimumVersions": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "description": "SemVer major.minor.patch, optional prerelease, no build metadata."
                }
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "requires": {
            "type": "object",
            "properties": {
              "core": {
                "type": "string",
                "minLength": 1,
                "description": "Exact SemVer or whitespace-separated comparisons (< <= > >= =), intersected."
              },
              "features": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Exact SemVer or whitespace-separated comparisons (< <= > >= =), intersected."
                    }
                  },
                  "required": [
                    "id",
                    "version"
                  ],
                  "additionalProperties": false
                },
                "uniqueItems": true
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "blocked": {
            "type": "boolean"
          },
          "signatures": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "properties": {
                "format": {
                  "const": "veroscript-artifact-signature"
                },
                "formatVersion": {
                  "const": "0.1.1"
                },
                "algorithm": {
                  "type": "string",
                  "minLength": 1
                },
                "kind": {
                  "const": "distribution"
                },
                "bytes": {
                  "type": "string",
                  "pattern": "^(0|[1-9][0-9]*)$",
                  "maxLength": 20
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "keyId": {
                  "type": "string",
                  "minLength": 1
                },
                "keyVersion": {
                  "type": "string",
                  "minLength": 1
                },
                "signature": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "format",
                "formatVersion",
                "algorithm",
                "kind",
                "bytes",
                "sha256",
                "keyId",
                "keyVersion",
                "signature"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "sha256",
          "manifestSha256",
          "size"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "blocked": {
      "type": "boolean"
    },
    "withdrawn": {
      "type": "boolean"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "sourceId",
    "name",
    "version",
    "artifacts"
  ],
  "additionalProperties": false
}

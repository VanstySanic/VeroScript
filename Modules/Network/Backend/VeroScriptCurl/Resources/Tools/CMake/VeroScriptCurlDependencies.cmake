include_guard(GLOBAL)
function(veroscript_curl_prepare)
	if(TARGET CURL::libcurl)
		get_target_property(_curl_imported CURL::libcurl IMPORTED)
		if(_curl_imported)
			find_package(CURL 8.13 REQUIRED)
		endif()
		return()
	endif()
	option(VEROSCRIPT_CURL_USE_SYSTEM_LIBRARY "Use an installed curl development package" OFF)
	if(VEROSCRIPT_CURL_USE_SYSTEM_LIBRARY)
		find_package(CURL 8.13 REQUIRED)
		return()
	endif()
	enable_language(C)
	set(BUILD_CURL_EXE OFF)
	set(BUILD_LIBCURL_DOCS OFF)
	set(BUILD_MISC_DOCS OFF)
	set(ENABLE_CURL_MANUAL OFF)
	set(BUILD_EXAMPLES OFF)
	set(BUILD_TESTING OFF)
	set(BUILD_SHARED_LIBS OFF)
	set(BUILD_STATIC_LIBS ON)
	# The same archive is consumed by the dynamic native extension and embedding hosts.
	set(CMAKE_POSITION_INDEPENDENT_CODE ON)
	set(CURL_USE_LIBPSL OFF)
	set(CURL_USE_LIBSSH2 OFF)
	set(CURL_USE_LIBSSH OFF)
	set(CURL_DISABLE_LDAP ON)
	set(CURL_DISABLE_LDAPS ON)
	set(CURL_ZLIB OFF)
	set(CURL_BROTLI OFF)
	set(CURL_ZSTD OFF)
	set(CMAKE_POLICY_DEFAULT_CMP0126 NEW)
	if(WIN32)
		set(CURL_USE_SCHANNEL ON)
		set(CURL_USE_OPENSSL OFF)
	else()
		set(CURL_USE_OPENSSL ON)
		if(APPLE AND CMAKE_SYSTEM_NAME STREQUAL "Darwin")
			# Cross builds cannot discover a host CA bundle. Use macOS trust services.
			set(USE_APPLE_SECTRUST ON)
		endif()
	endif()
	get_filename_component(_vs_network_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
	add_subdirectory("${_vs_network_root}/ThirdParty/curl" "${CMAKE_BINARY_DIR}/dependencies/curl")
endfunction()

@PACKAGE_INIT@
include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptJsonTargets.cmake")
set(VeroScriptJson_MODULE_DIR "${PACKAGE_PREFIX_DIR}/lib/veroscript/modules")
set(VeroScriptJson_Json_FOUND TRUE)
set(VeroScriptJson_Bindings_FOUND FALSE)
if("Bindings" IN_LIST VeroScriptJson_FIND_COMPONENTS AND
		EXISTS "${CMAKE_CURRENT_LIST_DIR}/VeroScriptJsonBindingsTargets.cmake")
	include(CMakeFindDependencyMacro)
	find_dependency(VeroScript 0.1.1 EXACT CONFIG)
	include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptJsonBindingsTargets.cmake")
	set(VeroScriptJson_Bindings_FOUND TRUE)
endif()
check_required_components(VeroScriptJson)

set(_vs_provider_default OFF)
if(TARGET VeroScript OR TARGET VeroScriptCore OR TARGET VeroScript::Core OR TARGET VeroScript::VeroScript OR VEROSCRIPT_GUI_SCRIPTING)
	set(_vs_provider_default ON)
endif()
option(VEROSCRIPT_STB_NATIVE_EXTENSION "Build the matched Core provider module" ${_vs_provider_default})
set(_vs_static_default OFF)
if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS" OR (MSVC AND CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL"))
	set(_vs_static_default ON)
endif()
option(VEROSCRIPT_STB_STATIC_PROVIDER "Link the named provider entry into an application" ${_vs_static_default})
if(VEROSCRIPT_STB_NATIVE_EXTENSION)
	if(TARGET VeroScript)
		set(_vs_provider_core VeroScript)
	elseif(TARGET VeroScriptCore)
		set(_vs_provider_core VeroScriptCore)
	elseif(TARGET VeroScript::Core)
		set(_vs_provider_core VeroScript::Core)
	elseif(TARGET VeroScript::VeroScript)
		set(_vs_provider_core VeroScript::VeroScript)
	else()
		find_package(VeroScript 0.1.1 EXACT CONFIG REQUIRED)
		set(_vs_provider_core VeroScript::VeroScript)
	endif()
	if(VEROSCRIPT_STB_STATIC_PROVIDER)
		add_library(VeroScriptStbModule STATIC Private/VeroScriptStbModule.cpp)
		target_compile_definitions(VeroScriptStbModule PUBLIC VEROSCRIPT_STB_STATIC_PROVIDER=1)
	else()
		add_library(VeroScriptStbModule SHARED Private/VeroScriptStbModule.cpp)
	endif()
	target_compile_definitions(VeroScriptStbModule PRIVATE VEROSCRIPT_STB_MODULE_EXPORTS=1)
	add_library(VeroScript::StbModule ALIAS VeroScriptStbModule)
	target_include_directories(VeroScriptStbModule PUBLIC "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/Public>" "$<INSTALL_INTERFACE:include/VeroScriptVisual>")
	target_include_directories(VeroScriptStbModule PRIVATE "$<TARGET_PROPERTY:${_vs_provider_core},INTERFACE_INCLUDE_DIRECTORIES>")
	target_link_libraries(VeroScriptStbModule PRIVATE VeroScriptStb)
	set_target_properties(VeroScriptStbModule PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME StbModule)
	vs_apply_cxx_defaults(VeroScriptStbModule)
	vs_install_windows_runtime(bin VeroScriptStbBindings)
	install(TARGETS VeroScriptStbModule EXPORT VeroScriptStbModuleTargets RUNTIME DESTINATION bin COMPONENT VeroScriptStbBindings LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT VeroScriptStbBindings ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT VeroScriptStbBindings)
	install(EXPORT VeroScriptStbModuleTargets NAMESPACE VeroScript:: DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/VeroScriptStb" COMPONENT VeroScriptStbBindings)
endif()

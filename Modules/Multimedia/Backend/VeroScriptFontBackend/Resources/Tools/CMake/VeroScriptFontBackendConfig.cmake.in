@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(VeroScriptFont 0.1.1 EXACT CONFIG)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptFontBackendDependenciesTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptFontBackendTargets.cmake")
set(VeroScriptFontBackend_Bindings_FOUND FALSE)
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/VeroScriptFontBackendModuleTargets.cmake")
	if("Bindings" IN_LIST VeroScriptFontBackend_FIND_COMPONENTS)
		find_dependency(VeroScript 0.1.1 EXACT CONFIG)
	endif()
	set(VeroScriptFontBackend_Bindings_FOUND TRUE)
	include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptFontBackendModuleTargets.cmake")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptFontBackendRelease.cmake" OPTIONAL)
check_required_components(VeroScriptFontBackend)

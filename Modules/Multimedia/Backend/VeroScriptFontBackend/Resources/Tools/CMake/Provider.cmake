set(_vs_provider_default OFF)
if(TARGET VeroScript OR TARGET VeroScriptCore OR TARGET VeroScript::Core OR TARGET VeroScript::VeroScript OR VEROSCRIPT_GUI_SCRIPTING)
	set(_vs_provider_default ON)
endif()
option(VEROSCRIPT_FONT_BACKEND_NATIVE_EXTENSION "Build the matched Core provider module" ${_vs_provider_default})
set(_vs_static_default OFF)
if(ANDROID OR EMSCRIPTEN OR CMAKE_SYSTEM_NAME STREQUAL "iOS" OR (MSVC AND CMAKE_MSVC_RUNTIME_LIBRARY AND NOT CMAKE_MSVC_RUNTIME_LIBRARY MATCHES "DLL"))
	set(_vs_static_default ON)
endif()
option(VEROSCRIPT_FONT_BACKEND_STATIC_PROVIDER "Link the named provider entry into an application" ${_vs_static_default})
if(VEROSCRIPT_FONT_BACKEND_NATIVE_EXTENSION)
	if(TARGET VeroScript)
		set(_vs_provider_core VeroScript)
	elseif(TARGET VeroScriptCore)
		set(_vs_provider_core VeroScriptCore)
	elseif(TARGET VeroScript::Core)
		set(_vs_provider_core VeroScript::Core)
	elseif(TARGET VeroScript::VeroScript)
		set(_vs_provider_core VeroScript::VeroScript)
	else()
		find_package(VeroScript 0.1.1 EXACT CONFIG REQUIRED)
		set(_vs_provider_core VeroScript::VeroScript)
	endif()
	if(VEROSCRIPT_FONT_BACKEND_STATIC_PROVIDER)
		add_library(VeroScriptFontBackendModule STATIC Private/Providers/VeroScriptFontBackendModule.cpp)
		target_compile_definitions(VeroScriptFontBackendModule PUBLIC VEROSCRIPT_FONT_BACKEND_STATIC_PROVIDER=1)
	else()
		add_library(VeroScriptFontBackendModule SHARED Private/Providers/VeroScriptFontBackendModule.cpp)
	endif()
	target_compile_definitions(VeroScriptFontBackendModule PRIVATE VEROSCRIPT_FONT_BACKEND_MODULE_EXPORTS=1)
	add_library(VeroScript::FontBackendModule ALIAS VeroScriptFontBackendModule)
	target_include_directories(VeroScriptFontBackendModule PUBLIC "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/Public>" "$<INSTALL_INTERFACE:include/VeroScriptVisual>")
	target_include_directories(VeroScriptFontBackendModule PRIVATE "$<TARGET_PROPERTY:${_vs_provider_core},INTERFACE_INCLUDE_DIRECTORIES>")
	target_link_libraries(VeroScriptFontBackendModule PRIVATE VeroScriptFontBackend)
	set_target_properties(VeroScriptFontBackendModule PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME FontBackendModule)
	vs_apply_cxx_defaults(VeroScriptFontBackendModule)
	vs_install_windows_runtime(bin VeroScriptFontBackendBindings)
	install(TARGETS VeroScriptFontBackendModule EXPORT VeroScriptFontBackendModuleTargets RUNTIME DESTINATION bin COMPONENT VeroScriptFontBackendBindings LIBRARY DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT VeroScriptFontBackendBindings ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT VeroScriptFontBackendBindings)
	install(EXPORT VeroScriptFontBackendModuleTargets NAMESPACE VeroScript:: DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/VeroScriptFontBackend" COMPONENT VeroScriptFontBackendBindings)
	if(BUILD_TESTING AND NOT CMAKE_CROSSCOMPILING)
		add_executable(VeroScriptFontBackendProviderTests Resources/Tests/ProviderTests.cpp)
		target_link_libraries(VeroScriptFontBackendProviderTests PRIVATE VeroScript::Font ${_vs_provider_core})
		if(MINGW)
			target_link_options(VeroScriptFontBackendProviderTests PRIVATE -municode)
		endif()
		vs_apply_cxx_defaults(VeroScriptFontBackendProviderTests)
		if(VEROSCRIPT_FONT_BACKEND_STATIC_PROVIDER)
			target_link_libraries(VeroScriptFontBackendProviderTests PRIVATE VeroScriptFontBackendModule)
			add_test(NAME VeroScriptFontBackendProviderTests COMMAND VeroScriptFontBackendProviderTests)
		else()
			add_dependencies(VeroScriptFontBackendProviderTests VeroScriptFontBackendModule)
			add_test(NAME VeroScriptFontBackendProviderTests COMMAND VeroScriptFontBackendProviderTests "$<TARGET_FILE:VeroScriptFontBackendModule>")
		endif()
		set_tests_properties(VeroScriptFontBackendProviderTests PROPERTIES TIMEOUT 30)
	endif()
endif()

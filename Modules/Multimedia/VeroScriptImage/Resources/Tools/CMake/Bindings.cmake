set(VEROSCRIPT_Image_BINDINGS_BUILT OFF)
if(VEROSCRIPT_VISUAL_SCRIPT_BINDINGS OR VEROSCRIPT_GUI_SCRIPTING)
	if(TARGET VeroScript)
		set(_vs_resource_core VeroScript)
	elseif(TARGET VeroScriptCore)
		set(_vs_resource_core VeroScriptCore)
	elseif(TARGET VeroScript::Core)
		set(_vs_resource_core VeroScript::Core)
	elseif(TARGET VeroScript::VeroScript)
		set(_vs_resource_core VeroScript::VeroScript)
	else()
		find_package(VeroScript 0.1.1 EXACT CONFIG REQUIRED)
		set(_vs_resource_core VeroScript::VeroScript)
	endif()
	add_library(VeroScriptImageBindings STATIC Private/VeroScriptImageBindings.cpp)
	add_library(VeroScript::ImageBindings ALIAS VeroScriptImageBindings)
	target_link_libraries(VeroScriptImageBindings PUBLIC VeroScriptImage "$<BUILD_INTERFACE:${_vs_resource_core}>" "$<INSTALL_INTERFACE:VeroScript::Core>")
	set_target_properties(VeroScriptImageBindings PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME ImageBindings)
	vs_apply_cxx_defaults(VeroScriptImageBindings)
	install(TARGETS VeroScriptImageBindings EXPORT VeroScriptImageBindingsTargets ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT VeroScriptImageBindings)
	install(EXPORT VeroScriptImageBindingsTargets NAMESPACE VeroScript:: DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/VeroScriptImage" COMPONENT VeroScriptImageBindings)
	install(FILES Public/VeroScriptImageBindings.h DESTINATION include/VeroScriptVisual COMPONENT VeroScriptImageBindings)
	set(VEROSCRIPT_Image_BINDINGS_BUILT ON)
	if(BUILD_TESTING)
		if(TARGET VeroScriptBytecodeVm)
			set(_vs_image_test_vm VeroScriptBytecodeVm)
		else()
			if(NOT TARGET VeroScript::VeroScriptBytecodeVm)
				find_package(VeroScriptBytecodeVm CONFIG REQUIRED)
			endif()
			set(_vs_image_test_vm VeroScript::VeroScriptBytecodeVm)
		endif()
		add_executable(VeroScriptImageBindingsTests Resources/Tests/BindingsTests.cpp)
		target_link_libraries(VeroScriptImageBindingsTests PRIVATE VeroScriptImageBindings ${_vs_image_test_vm})
		vs_apply_cxx_defaults(VeroScriptImageBindingsTests)
		add_test(NAME VeroScriptImageBindingsTests COMMAND VeroScriptImageBindingsTests)
		set_tests_properties(VeroScriptImageBindingsTests PROPERTIES TIMEOUT 30)
	endif()
endif()

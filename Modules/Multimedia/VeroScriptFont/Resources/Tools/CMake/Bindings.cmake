set(VEROSCRIPT_Font_BINDINGS_BUILT OFF)
if(VEROSCRIPT_VISUAL_SCRIPT_BINDINGS OR VEROSCRIPT_GUI_SCRIPTING)
	if(TARGET VeroScript)
		set(_vs_resource_core VeroScript)
	elseif(TARGET VeroScriptCore)
		set(_vs_resource_core VeroScriptCore)
	elseif(TARGET VeroScript::Core)
		set(_vs_resource_core VeroScript::Core)
	elseif(TARGET VeroScript::VeroScript)
		set(_vs_resource_core VeroScript::VeroScript)
	else()
		find_package(VeroScript 0.1.1 EXACT CONFIG REQUIRED)
		set(_vs_resource_core VeroScript::VeroScript)
	endif()
	add_library(VeroScriptFontBindings STATIC Private/VeroScriptFontBindings.cpp)
	add_library(VeroScript::FontBindings ALIAS VeroScriptFontBindings)
	target_link_libraries(VeroScriptFontBindings PUBLIC VeroScriptFont "$<BUILD_INTERFACE:${_vs_resource_core}>" "$<INSTALL_INTERFACE:VeroScript::Core>")
	set_target_properties(VeroScriptFontBindings PROPERTIES POSITION_INDEPENDENT_CODE ON EXPORT_NAME FontBindings)
	vs_apply_cxx_defaults(VeroScriptFontBindings)
	install(TARGETS VeroScriptFontBindings EXPORT VeroScriptFontBindingsTargets ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}" COMPONENT VeroScriptFontBindings)
	install(EXPORT VeroScriptFontBindingsTargets NAMESPACE VeroScript:: DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/VeroScriptFont" COMPONENT VeroScriptFontBindings)
	install(FILES Public/VeroScriptFontBindings.h DESTINATION include/VeroScriptVisual COMPONENT VeroScriptFontBindings)
	set(VEROSCRIPT_Font_BINDINGS_BUILT ON)
endif()

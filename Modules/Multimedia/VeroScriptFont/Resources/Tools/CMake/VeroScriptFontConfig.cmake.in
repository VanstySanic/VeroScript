@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptFontTargets.cmake")
set(VeroScriptFont_Bindings_FOUND FALSE)
if(Bindings IN_LIST VeroScriptFont_FIND_COMPONENTS AND
		EXISTS "${CMAKE_CURRENT_LIST_DIR}/VeroScriptFontBindingsTargets.cmake")
	if(NOT TARGET VeroScript::Core)
		include(CMakeFindDependencyMacro)
		find_dependency(VeroScript 0.1.1 EXACT CONFIG)
		if(TARGET VeroScript::VeroScript)
			add_library(VeroScript::Core ALIAS VeroScript::VeroScript)
		endif()
	endif()
	include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptFontBindingsTargets.cmake")
	set(VeroScriptFont_Bindings_FOUND TRUE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptFontRelease.cmake" OPTIONAL)
check_required_components(VeroScriptFont)

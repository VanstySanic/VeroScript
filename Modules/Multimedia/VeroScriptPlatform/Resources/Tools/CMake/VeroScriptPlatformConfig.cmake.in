@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(VeroScriptPlatform_FOUND TRUE)
set(VeroScriptPlatform_Bindings_FOUND FALSE)
include("${CMAKE_CURRENT_LIST_DIR}/../VeroScriptVisual/VeroScriptVisualPlatformTargets.cmake")
if("Bindings" IN_LIST VeroScriptPlatform_FIND_COMPONENTS AND
		EXISTS "${CMAKE_CURRENT_LIST_DIR}/../VeroScriptVisual/VeroScriptVisualPlatformBindingsTargets.cmake")
	find_dependency(VeroScript 0.1.1 EXACT CONFIG)
	if(NOT TARGET VeroScript::Core AND TARGET VeroScript::VeroScript)
		add_library(VeroScript::Core ALIAS VeroScript::VeroScript)
	endif()
	include("${CMAKE_CURRENT_LIST_DIR}/../VeroScriptVisual/VeroScriptVisualPlatformBindingsTargets.cmake")
	set(VeroScriptPlatform_Bindings_FOUND TRUE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptPlatformRelease.cmake" OPTIONAL)
check_required_components(VeroScriptPlatform)

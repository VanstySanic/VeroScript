@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(VeroScriptGraphics_FOUND TRUE)
set(VeroScriptGraphics_Bindings_FOUND FALSE)
include("${CMAKE_CURRENT_LIST_DIR}/../VeroScriptVisual/VeroScriptVisualGraphicsTargets.cmake")
if("Bindings" IN_LIST VeroScriptGraphics_FIND_COMPONENTS AND
		EXISTS "${CMAKE_CURRENT_LIST_DIR}/../VeroScriptVisual/VeroScriptVisualGraphicsBindingsTargets.cmake")
	find_dependency(VeroScript 0.1.1 EXACT CONFIG)
	if(NOT TARGET VeroScript::Core AND TARGET VeroScript::VeroScript)
		add_library(VeroScript::Core ALIAS VeroScript::VeroScript)
	endif()
	find_dependency(VeroScriptPlatform 0.1.1 EXACT CONFIG COMPONENTS Bindings)
	include("${CMAKE_CURRENT_LIST_DIR}/../VeroScriptVisual/VeroScriptVisualGraphicsBindingsTargets.cmake")
	set(VeroScriptGraphics_Bindings_FOUND TRUE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VeroScriptGraphicsRelease.cmake" OPTIONAL)
check_required_components(VeroScriptGraphics)
